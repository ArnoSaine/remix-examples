{
  "name": "my-remix-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@example/fluent-remix": "workspace:*",
    "@fluent/bundle": "^0.19.1",
    "@fluent/dom": "^0.10.2",
    "@fluent/langneg": "^0.7.0",
    "jsdom": "^30.1.0",
    "remix": "^3.0.0-rc.3"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "latest",
    "typescript": "latest"
  }
}
